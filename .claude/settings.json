  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-guard-trigger.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Bash(gh pr *)",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-guard-trigger.mjs\"",
            "timeout": 20
          },
          {
            "type": "command",
