#!/bin/sh
# Refuses any push that would update or delete main on the remote.
# A merge to main deploys the backend to production, so main changes only through a reviewed PR.
# git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>.
# Enable once per clone: git config core.hooksPath .githooks

refused=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    refused=1
  fi
done

if [ "$refused" -ne 0 ]; then
  echo "pre-push: refusing to push to main on $1 - main deploys production; push a task branch and open a PR instead." >&2
  exit 1
fi
exit 0
