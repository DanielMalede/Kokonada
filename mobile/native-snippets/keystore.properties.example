# OBSOLETE since #271 (OPS-303). The Android build reads no keystore.properties: Gradle signs no
# release build, and the only signing step is mobile/KokonadaHealth/scripts/release/sign-release.ps1,
# run as the Windows account kokonada-signer, which reads the upload key and its password only from
# C:\KokonadaSigner\vault. Do not fill this file in and do not copy it anywhere: no signing password
# goes into any checkout, in any file.
#
# The key below (kokonada-release.keystore, alias kokonada) is the retired key. It is replaced by a
# new upload key, and every copy of it is deleted or kept only offline (owner ruling F7, OPS-303).
# The new key, its password, the rotation and the Play App Signing choice are in
# docs/runbooks/android-release-signing.md, section 2.
#
# This file stays only because .gitignore, .githooks/pre-commit and
# backend/tests/preCommitSecretGuard.test.js name its exact path (OPS-356).

storeFile=kokonada-release.keystore
storePassword=CHANGE_ME
keyAlias=kokonada
keyPassword=CHANGE_ME
