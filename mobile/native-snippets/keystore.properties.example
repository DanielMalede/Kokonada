# Copy to mobile/KokonadaHealth/android/keystore.properties and fill in the real passwords.
# NEVER commit the filled-in file or the .keystore. mobile/KokonadaHealth/.gitignore ignores
# keystore.properties and *.keystore by basename there only; keep every other copy outside the repository.
#
# The release keystore already exists and is permanent: never create a second one
# (docs/runbooks/android-release-signing.md, section 2, which also covers the Play App Signing choice).

storeFile=kokonada-release.keystore
storePassword=CHANGE_ME
keyAlias=kokonada
keyPassword=CHANGE_ME
