# Only where mobile/KokonadaHealth/android/keystore.properties does not exist (restoring onto another
# machine from the DAN-053 item 3 backup): copy this there and fill in the passwords from that backup.
# Never copy it over an existing keystore.properties: in the main checkout that file holds the only
# recorded copy of the release passwords (KW-034).
#
# NEVER commit the filled-in file or the .keystore. mobile/KokonadaHealth/.gitignore ignores
# keystore.properties and *.keystore by basename there only; keep every other copy outside the repository.
#
# The release keystore already exists and is permanent: never create a second one
# (docs/runbooks/android-release-signing.md, section 2, which also covers the Play App Signing choice).

storeFile=kokonada-release.keystore
storePassword=CHANGE_ME
keyAlias=kokonada
keyPassword=CHANGE_ME
