# Environment
.env
.env.local
.env.*.local

# Dependencies
node_modules/
backend/venv/


# Logs
*.log
npm-debug.log*
logs/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Docker volumes
mongo-data/
redis-data/

# Root-level sibling RN companion app (regenerable). The in-repo mobile/KokonadaHealth/ IS tracked.
/KokonadaHealth/

# Large / generated ingestion artifacts — never commit corpus dumps or seeds
*.tar.zst
backend/wave1_seed_dump.ndjson

# Local git worktrees cut alongside the repo
.worktree-*/
.claude/worktrees/

# Android signing keystores (never commit — even the debug one)
**/debug.keystore
# Every copy of a signing key or of keystore.properties (the store and key passwords), under any
# name a copy gets: a .bak or "- Copy", a path flattened into the name (OPS-002). The pre-commit
# hook refuses the same names. Only the placeholder example is tracked.
**/*keystore*.properties*
**/*.keystore*
**/*.jks*
**/*.p12*
!/mobile/native-snippets/keystore.properties.example

# Headless-Chrome probe output from scripts/design/ — disposable, regenerated on every run
/.design-probe/

# Python bytecode
__pycache__/
*.pyc
