            "text.onInk",
            "plate.rim.base",
            "plate.rim.lit",
            "plate.ringHighlight",
            "bead.setting",
            "bead.shadow"
          ],
          "rule": "per direction and face: C == 0, or hue in [window.hueStart, window.hueEnd], or (C <= maxChroma and hue in [hueMin, hueMax])"
        }
      },
      "maxChroma": {"$type":"number","$value":0.004},
      "hueMin": {"$type":"number","$value":70},
