  "neverRed": {
    "$extensions": {
      "com.kokonada": {
        "lock": "owner:DEC-081",
        "status": "decided",
        "rule": "red iff hue in [start,end] inclusive and C >= floor"
      }
    },
    "check": {
      "hueStart": {"$type":"number","$value":350},
      "hueEnd": {"$type":"number","$value":50},
      "chromaFloor": {"$type":"number","$value":0.02}
    },
